[gd_resource type="Resource" script_class="SpacetimeDBPluginConfig" format=3]

[ext_resource type="Script" path="res://addons/SpacetimeDB/core_types/module_config.gd" id="1_mod"]
[ext_resource type="Script" path="res://addons/SpacetimeDB/codegen/parsed_schema.gd" id="2_ps"]
[ext_resource type="Script" path="res://addons/SpacetimeDB/core_types/plugin_config.gd" id="3_pc"]

[sub_resource type="Resource" id="Resource_ps"]
script = ExtResource("2_ps")

[sub_resource type="Resource" id="Resource_mod"]
script = ExtResource("1_mod")
name = "mmo-dev"
alias = "mmo"
hide_private_tables = true
parsed_schema = SubResource("Resource_ps")

[resource]
script = ExtResource("3_pc")
uri = &"http://127.0.0.1:3000"
module_configs = Dictionary[String, ExtResource("1_mod")]({
"mmo": SubResource("Resource_mod")
})
