<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-agnostic MmoSession.cs + generated bindings with plain .NET and runs a
       two-client smoke. Proves the Unity starter's session logic without the Unity editor. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SpacetimeDB.ClientSDK" Version="2.14.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/MmoSession.cs" />
    <Compile Include="../../Assets/SpacetimeDB/module_bindings/**/*.cs" />
  </ItemGroup>
</Project>
